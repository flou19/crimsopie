indicate parallel_sort ; (ptr, size_t n, depth d[ nat ], shared operator H1, shared operator H2, shared operator H3, shared operator H4, shared operator H5, shared operator H6, shared operator H7, shared operator H8, shared operator H9, shared operator H10, shared operator R1, shared operator R2, shared operator R3, shared operator R4)
    - act|n << n <( act )
    + n|T0 >> n|T
    \*yG
        ? P[ n, d ]
        + n|T0 >> n|T
        - (n|T0) << act <( T0 )
        @ frame< act >\
        live< act, n, T0, d >\
        | d |- >( 0 ) ? :
            / onpie< l, r, n, d >\ =
                + H1|T1 >> H1|T
                + H5|T5 >> H5|T
                + H7|T7 >> H7|T
                + H9|T9 >> H9|T
                + H10|T10 >> H10|T
                + H4|T4 >> H4|T
                + H6|T6 >> H6|T
                + H8|T8 >> H8|T
                + H3|T3 >> H3|T
                + H2|T2 >> H2|T
                - act|H1 << H1 <( act )
                ^ d[ nat ]
                ~ H9|T9
                + H9|T9 >> H9|T
                - H7|T7 << H5 <( H7 )
                # H9
    ~ H3|T3
    + H3|T3 >> H3|T'
    - act|H2 << H2 <( act )
    | l >( n ) ? :
        - H1|T1 << act <( H1 )
        ~ H2|T2
        + H2|T2 >> H2|T
        live< act, H1, H2, H3 >\
        gath } \i prt[ n, n, n-n, d ]
    / merge< H1, H2, H3, T1-T2-T3, P, d >\ =
        - H4|T4 << H3 <( H4 )
        & act|H10
        + H10|T10 >> H10|T
        / pivot< H1, H2, H3, P >\ =
            - act|H3 << H3 <( act )
            + H1|T1 >> H1|T
            > H3|T3 :=< H2|T2
            - H3|T3 << H2 <( H3 )
            + H4|T4 >> H4|T
            gFun live[ =<
                / act, R1, R2, R3, R4 >\ =
                    - R1|act << act <( R1 )
                    * R2|R3 * R4-act
                    + R4|act >> R4|T'
                    - act|R2 << R2 <( act )
                    % R3 % act
                    - R4|act << act <( R4 )
                    ~ R1|R2 := R3|R4
                >=
            eFun live]
            / onpie< l1, r1, l, d-1[ nat ] >\ =
                + H7|T7 >> H7|T'''
                ~~ H1|T1
                - act|H7 << H7 <( act )
                - H1|T1 << H1 <( H2 )
                / merge< H5, H6, H7, T5-T6-T7, P', d-1 >\ =
                    - H5|T5 << H6 <( H5 )
                    ? P'[ H5, d-1 ]
                    + H6|T6 >> H6|T
                    / onpie< l2, r2, P, d-2[ nat ] >\ =
                        - H8|T8 << H7 <( H8 )
                        + H8|T8 >> H8|T
                        * H8|T8 * H5|T5
                        - H7|T7 << H5 <( H7 )
                        + H5|T5 >> H5|T''
                        / onpie< l4, r4, H10, d-3[ nat ] >\ =
                            - H10|T10 << H9 <( H10 )
                            @ frame< H9 >\
                            + H9|T9 >> H9|T'
                            live< act, H5, H6, H7 >\
                            gath } \i prt[ H5, H6, H7, T5-T6-T7, P' ]
                - H6|T6 << H5 <( H6 )
            - act|H4 << H4 <( act )
            / onpie< l3, r3, H3, d-1 >\ =
                - H4|T4 << H3 <( H4 )
                + H5|T5 >> H5|T''
                live< act, H3, H4, H5 >\
                gath } \i prt[ H3, H4, H5, T3-T4-T5, P ]
        - act|H2 << H2 <( act )
        - H2|T2 << H1 <( H2 )
        ~ H2|T2
        + H2|T2 >> H2|T
        - H1|T1 << act <( H1 )
        - H2|T2 << act <( H2 )
        ~ H3|T3
        + H3|T3 >> H3|T
        - act|H3 << H3 <( act )
        - H3|T3 << act <( H3 )
        gath } \i prt[ H1, H2, H3, T1-T2-T3, P ]
    - act|H1 << H1 <( act )
    ~ H1|T1
    + H1|T1 >> H1|T
    - H2|T2 << H1 <( H2 )
    - act|H2 << H2 <( act )
    - H1|T1 << act <( H1 )
    ~ H2|T2
    + H2|T2 >> H2|T
    live< act, H1, H2, H3 >\
    gath } \i prt[ H1, H2, H3, T1-T2-T3, P ]
